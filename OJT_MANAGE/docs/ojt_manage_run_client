#!/usr/bin/env bash
# 서버 실행 후 다른 터미널에서 사용한다.
set -euo pipefail

usage() {
    cat <<'EOF'
사용법: ojt_manage_run_client [URL]

기본 접속: ojt_manage_run_client
다른 포트: ojt_manage_run_client http://127.0.0.1:8080/
404 확인: ojt_manage_run_client http://127.0.0.1:8000/not-found

기본 URL은 http://127.0.0.1:8000/입니다.
응답 헤더와 본문을 출력하고 종료합니다. 요청 제한 시간은 5초입니다.
EOF
}

if [[ $# -eq 1 && ( "$1" == '-h' || "$1" == '--help' ) ]]; then
    usage
    exit 0
fi
if [[ $# -gt 1 ]]; then
    usage >&2
    exit 2
fi

url="${1-http://127.0.0.1:8000/}"
case "$url" in
    http://*|https://*) ;;
    *) echo '오류: http:// 또는 https://로 시작하는 URL을 지정하세요.' >&2; exit 2 ;;
esac

if ! command -v curl >/dev/null 2>&1; then
    echo '오류: curl이 필요합니다. Ubuntu/Debian: sudo apt install curl' >&2
    exit 127
fi

# 실습 서버에 직접 접속한다. HTTP 404도 응답 확인을 위해 그대로 출력한다.
exec curl --noproxy '*' -sS -i --max-time 5 -- "$url"
