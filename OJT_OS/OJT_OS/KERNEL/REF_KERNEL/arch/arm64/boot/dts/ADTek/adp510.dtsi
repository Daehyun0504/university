			compatible = "snps,designware-i2s";
			reg = <0x0 0x2002D000 0x0 0x1000>;
			clocks = <&iicclk 0>;
			clock-names = "i2sclk";
			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
			#sound-dai-cells = <0>;
			dmas = <&pdma0 5 1>,
				   <&pdma0 4 0>;
			dma-names = "rx", "tx";
			status = "disabled";
		};
		i2s3: i2s@2002E000 {
			compatible = "snps,designware-i2s";
			reg = <0x0 0x2002E000 0x0 0x1000>;
			clocks = <&iicclk 0>;
			clock-names = "i2sclk";
			interrupts = <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
			#sound-dai-cells = <0>;
			dmas = <&pdma0 7 1>,
				   <&pdma0 6 0>;
			dma-names = "rx", "tx";
			status = "disabled";
		};
*/

		/*
		 * SDIO_EMMC
		 * 0x2010 0000 ~ 0x2010 FFFF  - SDIO_EMMC
		 * GIC : 18 or 19
		 */
		sdio0: mmc@20100000 {
                        compatible = "snps,dwcmshc-sdhci";
                        reg = <0x0 0x20100000 0x0 0x10000>;
                        clocks = <&sdioclk>, <&sdioclk>;
                        clock-names = "core", "bus";
                        interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 19 IRQ_TYPE_LEVEL_HIGH>;
			bus-width = <4>;
                        status = "disabled";
                };

		/*
		 * GMAC
		 * 0x2040 0000 ~ 0x204F FFFF  - GMAC  compatible = "snps,dwmac-4.10a"
		 */
		ethernet0: ethernet@20400000 {
			compatible = "snps,dwmac";
			reg = <0x0 0x20400000 0x0 0x100000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq";
			phy-mode = "sgmii";
			clocks = <&gmac_clk_in>;
			clock-names = "stmmaceth";
			status = "disabled";
		};

		/*
		 * 0x3000 1000 ~ 0x3000 1FFF  - TS_CORECTRL
		 */

		/*
		 * 0x3000 2000 ~ 0x3000 2FFF  - SYS_CTRL
		 */

		/*
		 * Watchdog  - OK
		 */
		 /*
		watchdog0: watchdog@30004000 {
			compatible = "arm,sp805", "arm,primecell";
			reg = <0x0 0x30004000 0x0 0x1000>;
			interrupts = <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&wdtclk>, <&sys_pll>;
			clock-names = "wdog_clk", "apb_pclk";
			status = "disabled";
		};
		*/

		/*
		 * 0x3000 6000 ~ 0x3000 6FFF  - PPC
		 */
		/*
	   arm_cc712: crypto@80000000 {
			   compatible = "arm,cryptocell-712-ree";
			   interrupt-parent = <&intc>;
			   interrupts = < 0 30 4 >;
			   reg = < 0x80000000 0x10000 >;
	   };
		*/

		/*
		 * 0x3000 7000 ~ 0x3000 7FFF  - MPC
		 */
	};
};
